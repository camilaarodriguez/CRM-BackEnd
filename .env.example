# Modelo das variaveis de ambiente da API. Copie para .env (que o Git ignora)
# e preencha com os seus valores. NUNCA commite o arquivo .env com valores reais.
#
# Na EC2 o deploy/setup.sh gera estes valores sozinho em /etc/crm/crm.env.

# Banco de dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/crmdb
DB_USERNAME=crm
DB_PASSWORD=troque-por-uma-senha-forte

# JWT: no minimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
# Validade do token em milissegundos (7200000 = 2 horas)
JWT_EXPIRATION_MS=7200000

# Origens do front liberadas no CORS, separadas por virgula
CORS_ORIGINS=http://localhost:4200

# Administrador criado na primeira execucao (somente se ainda nao houver nenhum)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=troque-por-uma-senha-forte

# Telegram (opcional: sem token as notificacoes sao ignoradas)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mostrar o SQL no log (deixe false em producao)
SHOW_SQL=false
